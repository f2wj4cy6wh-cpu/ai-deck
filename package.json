{
    "name": "ai-deck",
    "version": "0.1.0",
    "private": true,
    "description": "Find Claude skills, plugins, MCP servers, prompts and repos by describing what you need in plain English.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o public/styles.css --minify",
        "watch:css": "tailwindcss -c tailwind.config.cjs -i src/styles.css -o public/styles.css --watch",
        "ingest": "node scripts/ingest.js",
        "ingest:offline": "node scripts/ingest.js --offline",
        "start": "node server/index.js",
        "dev": "npm run build:css && node --watch server/index.js",
        "test": "node --test \"test/*.test.js\""
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^1.3.0"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.17"
    }
}
