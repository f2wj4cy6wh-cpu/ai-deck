{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-deck",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",
  // The Anthropic SDK and ai.js read process.env, which nodejs_compat populates from secrets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Served on *.workers.dev until the aidecks.dev domain is registered.
  "workers_dev": true,
  "preview_urls": false,
  // Re-enable once aidecks.dev is registered:
  // "routes": [{ "pattern": "aidecks.dev", "custom_domain": true }],
  // Wrangler provisions this namespace on first deploy.
  "kv_namespaces": [{ "binding": "SUBMISSIONS" }],
  // Per-IP limits on the routes that write to KV or spend AI credits (worker/index.js guard()).
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RANK_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
