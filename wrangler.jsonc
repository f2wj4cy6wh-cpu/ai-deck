{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-deck",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-28",
  // The Anthropic SDK and ai.js read process.env, which nodejs_compat populates from secrets.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Served on *.workers.dev until the aidecks.dev domain is registered.
  "workers_dev": true,
  "preview_urls": false,
  // Re-enable once aidecks.dev is registered:
  // "routes": [{ "pattern": "aidecks.dev", "custom_domain": true }],
  // Wrangler provisions this namespace on first deploy.
  "kv_namespaces": [{ "binding": "SUBMISSIONS" }],
  "observability": { "enabled": true }
}
